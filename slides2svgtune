JS = r"""
async () => {
  const NS = 'http://www.w3.org/2000/svg';
  const esc = s => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  let next = 1;  // build orders as the Slides runtime reads them: no order = the next one
  const effects = ['fade', 'rise', 'drop', 'left', 'right', 'scale', 'pop'];
  const num = v => {
    const w = (v || '').trim().toLowerCase().split(/\s+/);
    if (!effects.includes(w[0])) return null;
    let k = next; for (const x of w.slice(1)) if (/^\d+$/.test(x)) k = Math.max(1, Math.min(50, +x));
    next = Math.max(next, k + 1); return k;
  };
  const f = v => (Math.round(v * 100) / 100).toString();
  const sec = document.querySelector('section');
  const S = sec.getBoundingClientRect();
  const skipped = new Set();  // what is not (exactly) converted, to warn about

  // 1. remember transforms and lay out without them (measure untransformed)
  const tr = new Map();
  sec.querySelectorAll('*').forEach(e => {
    if (e.parentElement && e.parentElement.closest('svg')) return;  // keep SVG-internal transforms
    const cs = getComputedStyle(e);
    if (cs.transform && cs.transform !== 'none') { tr.set(e, [cs.transform, cs.transformOrigin]); e.style.transform = 'none'; }
  });

  // 2. connectors -> inline svg (same geometry as the Slides runtime, approx.)
  sec.querySelectorAll('x-connector').forEach(c => {
    const P = c.parentElement, B = P.getBoundingClientRect();  // the section or a host <div>
    const g = (n, o, size) => { const v = (c.getAttribute(n) || '').trim(); return o + (v.endsWith('%') ? parseFloat(v) / 100 * size : parseFloat(v)); };
    const ox = B.left - S.left + P.clientLeft, oy = B.top - S.top + P.clientTop;
    const x1 = g('x1', ox, P.clientWidth), y1 = g('y1', oy, P.clientHeight), x2 = g('x2', ox, P.clientWidth), y2 = g('y2', oy, P.clientHeight);
    if ([x1, y1, x2, y2].some(isNaN)) { skipped.add('<x-connector> without x1 y1 x2 y2'); c.remove(); return; }
    const st = c.style, color = st.color || '#000', w = parseFloat(st.borderWidth) || 2;
    const dashed = /dash/.test(st.borderStyle || ''), dotted = /dot/.test(st.borderStyle || '');
    const head = c.getAttribute('head') || 'end', route = c.getAttribute('route') || 'straight';
    const hs = c.getAttribute('head-start') || (head === 'both' ? 'filled' : 'none');
    const he = c.getAttribute('head-end') || (head === 'none' ? 'none' : 'filled');
    if (hs === 'open' || he === 'open') skipped.add('open connector heads (drawn filled)');
    let pts;
    if (route === 'hv') pts = [[x1, y1], [x2, y1], [x2, y2]];
    else if (route === 'vh') pts = [[x1, y1], [x1, y2], [x2, y2]];
    else if (route === 'elbow') {
      if (Math.abs(x2 - x1) >= Math.abs(y2 - y1)) { const m = (x1 + x2) / 2; pts = [[x1, y1], [m, y1], [m, y2], [x2, y2]]; }
      else { const m = (y1 + y2) / 2; pts = [[x1, y1], [x1, m], [x2, m], [x2, y2]]; }
    } else pts = [[x1, y1], [x2, y2]];
    pts = pts.filter((p, i) => i === 0 || p[0] !== pts[i - 1][0] || p[1] !== pts[i - 1][1]);
    const L = Math.max(4 * w, 10), H = L * 0.45;
    let heads = '';
    const arrow = (a, b) => {
      const dx = b[0] - a[0], dy = b[1] - a[1], d = Math.hypot(dx, dy) || 1, ux = dx / d, uy = dy / d;
      const bx = b[0] - ux * L, by = b[1] - uy * L;
      heads += `<path d="M${f(b[0])},${f(b[1])} L${f(bx - uy * H)},${f(by + ux * H)} L${f(bx + uy * H)},${f(by - ux * H)} Z" fill="${color}"/>`;
      return [bx + ux * 0.5, by + uy * 0.5];
    };
    const line = pts.map(p => p.slice());
    if (he !== 'none') line[line.length - 1] = arrow(pts[pts.length - 2], pts[pts.length - 1]);
    if (hs !== 'none') line[0] = arrow(pts[1], pts[0]);
    let dash = '';
    if (dashed) dash = ` stroke-dasharray="${3 * w + 4} ${2 * w + 4}"`;
    if (dotted) dash = ` stroke-dasharray="0 ${2 * w + 2}"`;
    const s = document.createElement('x-svgfrag');
    { const xs = pts.map(q => q[0]), ys = pts.map(q => q[1]), m = L;
      s.dataset.bbox = JSON.stringify([Math.min(...xs) - m, Math.min(...ys) - m, Math.max(...xs) + m, Math.max(...ys) + m]); }
    s.dataset.svg = `<polyline points="${line.map(p => p.map(f).join(',')).join(' ')}" fill="none" stroke="${color}" stroke-width="${w}" stroke-linecap="round" stroke-linejoin="round"${dash}/>` + heads;
    for (const a of c.attributes) if (/^(id|data-build-)/.test(a.name)) s.setAttribute(a.name, a.value);
    c.replaceWith(s);
  });

  await document.fonts.ready;

  const ctx = document.createElement('canvas').getContext('2d');
  const ascent = cs => {
    ctx.font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
    const m = ctx.measureText('Hg');
    return m.fontBoundingBoxAscent;
  };
  const color = c => {  // -> [hex-ish, opacity]
    const m = c.match(/rgba?\(([^)]+)\)/); if (!m) return [c, 1];
    const p = m[1].split(',').map(s => parseFloat(s));
    return [`rgb(${p[0]},${p[1]},${p[2]})`, p.length > 3 ? p[3] : 1];
  };
  const radii = (cs, w, h) => {  // [[rx, ry]] for tl, tr, br, bl, scaled down to fit as in CSS
    // % as the Slides format reads it: >= 50% is a pill (256px), else that % of 256px
    const v = s => (s.endsWith('%') ? (parseFloat(s) >= 50 ? 256 : Math.round(parseFloat(s) * 2.56)) : parseFloat(s)) || 0;
    const r = ['TopLeft', 'TopRight', 'BottomRight', 'BottomLeft'].map(k => {
      const [a, b = a] = cs[`border${k}Radius`].split(' '); return [v(a), v(b)];
    });
    const k = Math.min(1, w / (r[0][0] + r[1][0]), w / (r[3][0] + r[2][0]), h / (r[0][1] + r[3][1]), h / (r[1][1] + r[2][1]));
    return r.map(([a, b]) => (a && b ? [a * k, b * k] : [0, 0]));
  };
  const rp = (x, y, w, h, r) => {  // rounded rect path data
    const [[a, A], [b, B], [c, C], [d, D]] = r;
    return `M${f(x + a)},${f(y)} H${f(x + w - b)} A${f(b)},${f(B)} 0 0 1 ${f(x + w)},${f(y + B)} V${f(y + h - C)} A${f(c)},${f(C)} 0 0 1 ${f(x + w - c)},${f(y + h)} H${f(x + d)} A${f(d)},${f(D)} 0 0 1 ${f(x)},${f(y + h - D)} V${f(y + A)} A${f(a)},${f(A)} 0 0 1 ${f(x + a)},${f(y)} Z`;
  };
  const rr = (x, y, w, h, r) => {  // rounded rect element, open for more attributes
    const [a, b] = r[0];
    if (r.every(q => q[0] === a && q[1] === b))
      return `<rect x="${f(x)}" y="${f(y)}" width="${f(w)}" height="${f(h)}"${a ? ` rx="${f(a)}"` : ''}${b !== a ? ` ry="${f(b)}"` : ''}`;
    return `<path d="${rp(x, y, w, h, r)}"`;
  };

  const box = (e, cs, R) => {
    let out = '';
    const x = R.left - S.left, y = R.top - S.top, w = R.width, h = R.height;
    if (!w || !h) return '';
    const ellipse = e.tagName === 'X-SHAPE' && (e.getAttribute('kind') || '').trim().toLowerCase() === 'ellipse';
    const rad = ellipse ? Array(4).fill([w / 2, h / 2]) : radii(cs, w, h);
    const [bg, bga] = color(cs.backgroundColor);
    if (bga > 0) out += rr(x, y, w, h, rad) + ` fill="${bg}"${bga < 1 ? ` fill-opacity="${f(bga)}"` : ''}/>`;
    const sides = ['Top', 'Right', 'Bottom', 'Left'].map(s => [parseFloat(cs[`border${s}Width`]) || 0, cs[`border${s}Style`], cs[`border${s}Color`]]);
    if (sides.some(s => s.join() !== sides[0].join())) {  // per-side widths (one style and color): an even-odd ring
      const [[t], [r], [b], [l]] = sides, s = sides.find(s => s[0] > 0), iw = w - l - r, ih = h - t - b;
      if (!s) return out;
      if (s[1] !== 'solid') skipped.add(`${s[1]} border on some sides only (drawn solid)`);
      const [c, a] = color(s[2]), ins = [[l, t], [r, t], [r, b], [l, b]];
      const inner = iw > 0 && ih > 0 ? ' ' + rp(x + l, y + t, iw, ih, rad.map(([p, q], i) => [Math.max(p - ins[i][0], 0), Math.max(q - ins[i][1], 0)])) : '';
      return out + `<path d="${rp(x, y, w, h, rad)}${inner}" fill-rule="evenodd" fill="${c}"${a < 1 ? ` fill-opacity="${f(a)}"` : ''}/>`;
    }
    const bw = parseFloat(cs.borderTopWidth) || 0, bs = cs.borderTopStyle;
    if (bw > 0 && bs !== 'none' && bs !== 'hidden') {
      const [bc, bca] = color(cs.borderTopColor);
      const op = bca < 1 ? ` stroke-opacity="${f(bca)}"` : '';
      const stroke = (inset, sw, extra = '') => rr(x + inset, y + inset, w - 2 * inset, h - 2 * inset, rad.map(([p, q]) => [Math.max(p - inset, 0), Math.max(q - inset, 0)])) + ` fill="none" stroke="${bc}" stroke-width="${f(sw)}"${op}${extra}/>`;
      if (bs === 'double') { const t = bw / 3; out += stroke(t / 2, t) + stroke(bw - t / 2, t); }
      else if (bs === 'dashed') out += stroke(bw / 2, bw, ` stroke-dasharray="${f(bw * 3)} ${f(bw * 2)}"`);
      else if (bs === 'dotted') out += stroke(bw / 2, bw, ` stroke-dasharray="0 ${f(bw * 2)}" stroke-linecap="round"`);
      else out += stroke(bw / 2, bw);
    }
    return out;
  };

  const text = (node) => {
    const el = node.parentElement, cs = getComputedStyle(el);
    if (cs.visibility === 'hidden') return '';
    const s = node.data, r = document.createRange(), lines = [];
    let cur = null;
    for (let i = 0; i < s.length; i++) {
      r.setStart(node, i); r.setEnd(node, i + 1);
      const rects = r.getClientRects(); if (!rects.length) continue;
      const q = rects[0]; if (!q.width && /\s/.test(s[i])) continue;
      if (!cur || Math.abs(q.top - cur.top) > 2) { cur = { top: q.top, left: q.left, txt: '' }; lines.push(cur); }
      cur.txt += /\s/.test(s[i]) ? ' ' : s[i];
    }
    const tt = cs.textTransform, [fill, fa] = color(cs.color);
    let td = 'none';  // decorations reach inline descendants, e.g. <u>a <b>b</b></u>
    for (let p = el; p !== sec; p = p.parentElement) { const ps = getComputedStyle(p); td = ps.textDecorationLine; if (td !== 'none' || ps.display !== 'inline') break; }
    const a = ascent(cs);
