    for (const L of lines) {
      let t = L.txt.replace(/ +/g, ' ').replace(/ +$/, '');  // HTML collapses runs of spaces
      if (!t.trim()) continue;
      if (tt === 'uppercase') t = t.toUpperCase(); else if (tt === 'lowercase') t = t.toLowerCase();
      const ls = parseFloat(cs.letterSpacing) || 0;
      out += `<text xml:space="preserve" x="${f(L.left - S.left)}" y="${f(L.top - S.top + a)}" font-family="${esc(cs.fontFamily.replace(/"/g, "'"))}" font-size="${cs.fontSize}" font-weight="${cs.fontWeight}"${cs.fontStyle !== 'normal' ? ` font-style="${cs.fontStyle}"` : ''}${ls ? ` letter-spacing="${f(ls)}"` : ''}${td !== 'none' ? ` text-decoration="${td}"` : ''} fill="${fill}"${fa < 1 ? ` fill-opacity="${f(fa)}"` : ''}>${esc(t)}</text>`;
    }
    if (!out) return '';
    const link = el.closest('a[href]');
    return link ? `<a href="${esc(link.getAttribute('href'))}" xlink:href="${esc(link.getAttribute('href'))}">${out}</a>` : out;
  };

  const walk = (e) => {
    if (e.nodeType === 3) return text(e);
    if (e.nodeType !== 1) return '';
    const tag = e.tagName.toLowerCase();
    if (tag === 'aside' || tag === 'template') return '';
    const cs = getComputedStyle(e);
    if (cs.display === 'none') return '';
    if (/^(img|video|iframe|canvas|x-embed|x-icon)$/.test(tag)) { skipped.add(`<${tag}>`); return ''; }
    const kind = tag === 'x-shape' ? (e.getAttribute('kind') || '').trim().toLowerCase() : '';
    if (/^(diamond|arrow-)/.test(kind)) skipped.add(`<x-shape kind=${kind}> (drawn as a rectangle)`);
    if (tag === 'li') skipped.add('list markers');
    if (tag !== 'svg') for (const [p, none] of [['background-image', 'none'], ['box-shadow', 'none'], ['text-shadow', 'none'], ['filter', 'none'], ['mix-blend-mode', 'normal']])
      if (cs.getPropertyValue(p) !== none) skipped.add(p);
    if (cs.textTransform === 'capitalize') skipped.add('text-transform:capitalize');
    let out;
    if (tag === 'x-svgfrag') out = e.dataset.svg;
    else if (tag === 'svg') {
      const R = e.getBoundingClientRect(), c = e.cloneNode(true);
      c.removeAttribute('style'); for (const a of [...c.attributes]) if (a.name.startsWith('data-')) c.removeAttribute(a.name);
      c.setAttribute('x', f(R.left - S.left)); c.setAttribute('y', f(R.top - S.top));
      c.setAttribute('width', f(R.width)); c.setAttribute('height', f(R.height));
      out = new XMLSerializer().serializeToString(c);
    } else {
      out = box(e, cs, e.getBoundingClientRect());
      for (const ch of e.childNodes) out += walk(ch);
    }
    if (out && +cs.opacity < 1) out = `<g opacity="${f(+cs.opacity)}">${out}</g>`;
    const t = tr.get(e);
    if (t && out) {
      const R = e.getBoundingClientRect(), o = t[1].split(' ').map(parseFloat);
      const ox = R.left - S.left + o[0], oy = R.top - S.top + o[1];
      out = `<g transform="translate(${f(ox)},${f(oy)}) ${t[0]} translate(${f(-ox)},${f(-oy)})">${out}</g>`;
    }
    return out;
  };

  // 3. top-level elements -> (label, in, out, svg)
  const items = [], scs = getComputedStyle(sec), [sbg, sba] = color(scs.backgroundColor);
  if (sba > 0) items.push({ id: '', name: null, inn: null, out: null, bbox: [0, 0, S.width, S.height],
    svg: `<rect width="${f(S.width)}" height="${f(S.height)}" fill="${sbg}"${sba < 1 ? ` fill-opacity="${f(sba)}"` : ''}/>` });
  if (scs.backgroundImage !== 'none') skipped.add('background-image');
  for (const ch of sec.children) {
    const pinned = ch.tagName === 'X-SVGFRAG' || getComputedStyle(ch).position === 'absolute';  // only these build
    const inn = pinned ? num(ch.getAttribute('data-build-in')) : null, out = pinned ? num(ch.getAttribute('data-build-out')) : null;
    const svg = walk(ch); if (!svg && inn === null && out === null) continue;
    const id = ch.getAttribute('id') || '';
    let bbox;
    if (ch.dataset && ch.dataset.bbox) bbox = JSON.parse(ch.dataset.bbox);
    else { const R = ch.getBoundingClientRect(); bbox = [R.left - S.left, R.top - S.top, R.right - S.left, R.bottom - S.top];
           const t = tr.get(ch); if (t) { const c = [(bbox[0] + bbox[2]) / 2, (bbox[1] + bbox[3]) / 2], r = Math.hypot(bbox[2] - bbox[0], bbox[3] - bbox[1]) / 2; bbox = [c[0] - r, c[1] - r, c[0] + r, c[1] + r]; } }
    items.push({
      id, name: id.includes('--') ? id.split('--')[0] : null,
      inn, out, svg, bbox,
    });
  }
  return { items, skipped: [...skipped] };
}
