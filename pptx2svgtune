@dataclass
class Run:
    text: str  # "\n" for a line break
    size: float
    bold: bool
    italic: bool
    color: str
    family: str
    href: str | None = None


@dataclass
class Para:
    runs: list
    align: str
    space_before: float = 0.0
    space_after: float = 0.0
    line_scale: float = 1.0


@dataclass
class Shape:
    name: str
    kind: str  # "shape", "line", or "picture"
    geom: str
    x: float
    y: float
    w: float
    h: float
    rot: float = 0.0
    flip_h: bool = False
    flip_v: bool = False
    adj: float | None = None
    fill: str | None = None
    fill_opacity: float = 1.0
    stroke: str | None = None
    stroke_width: float = 0.0
    dashed: bool = False
    arrow_start: bool = False
    arrow_end: bool = False
    paras: list = field(default_factory=list)
    insets: tuple = (7.2, 3.6, 7.2, 3.6)  # l, t, r, b
    anchor: str = "t"
    wrap: bool = True
    href: str | None = None
    image: str | None = None  # data: URI
    transforms: list = field(default_factory=list)  # of enclosing groups, outermost first


class Slide:
    """Reads the shapes of one slide."""

    def __init__(self, pkg: Package, part: str, default_font: str):
        self.pkg, self.part = pkg, part
        self.xml = pkg.xml(part)
        self.rels = pkg.rels(part)
        self.theme = Theme(pkg, part)
        pres = pkg.xml("ppt/presentation.xml")
        size = pres.find("p:sldSz", NS)
        self.width, self.height = pt(size.get("cx")), pt(size.get("cy"))
        defrpr = pres.find("p:defaultTextStyle/a:lvl1pPr/a:defRPr", NS)
        self.default_size = int(defrpr.get("sz", 1800)) / 100 if defrpr is not None else 18.0
        self.default_font = self.theme.fonts.get("minor", default_font)

    def href(self, parent) -> str | None:
        """The external URL of an a:hlinkClick within parent, if any."""
        link = parent.find("a:hlinkClick", NS) if parent is not None else None
        if link is None or not link.get(R_ID):
            return None
        rel = self.rels.get(link.get(R_ID))
        if rel is None or not rel[2]:
            warn(f"link {link.get('action') or link.get(R_ID)} is not to a URL: ignored")
            return None
        return rel[1]

    def resolve_font(self, typeface: str | None) -> str | None:
        if not typeface:
            return None
        if typeface.startswith("+mj"):
            return self.theme.fonts.get("major", self.default_font)
        if typeface.startswith("+mn"):
            return self.theme.fonts.get("minor", self.default_font)
        return typeface

    def shapes(self):
        """Yield (shape, group names) for every drawable element, outermost first."""
        tree = self.xml.find("p:cSld/p:spTree", NS)
        yield from self._walk(tree, lambda x, y, w, h: (x, y, w, h), [], [])

    def _walk(self, tree, place, transforms, groups):
        for el in tree:
            tag = localname(el)
            if tag in ("nvGrpSpPr", "grpSpPr", "extLst"):
                continue
            if tag == "grpSp":
                yield from self._group(el, place, transforms, groups)
            elif tag in ("sp", "cxnSp", "pic"):
                shp = self.parse(el, tag, place)
                if shp is not None:
                    shp.transforms = list(transforms)
                    yield shp, groups
            else:
                name = el.find(".//p:cNvPr", NS)
                what = f"{name.get('name')!r} (<{tag}>)" if name is not None else f"<{tag}>"
                warn(f"{what}: not supported, skipped")

    def _group(self, grp, place, transforms, groups):
        name = grp.find("p:nvGrpSpPr/p:cNvPr", NS).get("name")
        xfrm = grp.find("p:grpSpPr/a:xfrm", NS)
        if xfrm is None:
            yield from self._walk(grp, place, transforms, groups + [name])
            return
        off, ext = xfrm.find("a:off", NS), xfrm.find("a:ext", NS)
        choff, chext = xfrm.find("a:chOff", NS), xfrm.find("a:chExt", NS)
        gx, gy, gw, gh = pt(off.get("x")), pt(off.get("y")), pt(ext.get("cx")), pt(ext.get("cy"))
        cx, cy = pt(choff.get("x")), pt(choff.get("y"))
        cw, ch = pt(chext.get("cx")), pt(chext.get("cy"))
        sx, sy = (gw / cw if cw else 1.0), (gh / ch if ch else 1.0)

        def inner(x, y, w, h):
            return place(gx + (x - cx) * sx, gy + (y - cy) * sy, w * sx, h * sy)

        transforms = list(transforms)
        if xfrm.get("rot"):
            bx, by, bw, bh = place(gx, gy, gw, gh)
            transforms.append(f"rotate({fmt(int(xfrm.get('rot')) / 60000)} {fmt(bx + bw / 2)} {fmt(by + bh / 2)})")
        if xfrm.get("flipH") == "1" or xfrm.get("flipV") == "1":
            warn(f"group {name!r}: flipping groups is not supported")
        yield from self._walk(grp, inner, transforms, groups + [name])

    def parse(self, el, tag, place) -> Shape | None:
        nv = el.find("p:nvSpPr" if tag == "sp" else "p:nvCxnSpPr" if tag == "cxnSp" else "p:nvPicPr", NS)
        cnvpr = nv.find("p:cNvPr", NS)
        name = cnvpr.get("name")
        sppr = el.find("p:spPr", NS)
        xfrm = sppr.find("a:xfrm", NS) if sppr is not None else None
        if xfrm is None or xfrm.find("a:off", NS) is None:
            if nv.find("p:nvPr/p:ph", NS) is not None:
                warn(f"{name!r}: placeholder without a position of its own (move it once in PowerPoint), skipped")
            else:
                warn(f"{name!r}: no position, skipped")
            return None
        off, ext = xfrm.find("a:off", NS), xfrm.find("a:ext", NS)
        x, y, w, h = place(pt(off.get("x")), pt(off.get("y")), pt(ext.get("cx")), pt(ext.get("cy")))
        geom = sppr.find("a:prstGeom", NS)
        if tag == "pic":
            kind, prst = "picture", "rect"
        elif geom is None:
            warn(f"{name!r}: custom geometry not supported, skipped")
            return None
        else:
            prst = geom.get("prst")
            kind = "line" if prst in LINE_GEOMS else "shape" if prst in SHAPE_GEOMS else None
            if kind is None:
                warn(f"{name!r}: geometry {prst} not supported, skipped")
                return None
        shp = Shape(name, kind, prst, x, y, w, h, int(xfrm.get("rot", 0)) / 60000,
                    xfrm.get("flipH") == "1", xfrm.get("flipV") == "1")
        shp.href = self.href(cnvpr)
        gd = geom.find("a:avLst/a:gd", NS) if geom is not None else None
        if gd is not None:
            shp.adj = int(gd.get("fmla").split()[1]) / 1e5
        style = el.find("p:style", NS)
        if kind == "picture":
            shp.image = self.image(el, name)
            if shp.image is None:
                return None
        else:
            shp.fill, shp.fill_opacity = self.fill(sppr, style, name)
        self.outline(shp, sppr, style)
        if nv.find("p:nvPr/p:ph", NS) is not None:
            warn("text of placeholders uses default sizes (text styles of the layout and master are not applied)")
        body = el.find("p:txBody", NS)
        if body is not None:
            self.text(shp, body, style)
        return shp

    def fill(self, sppr, style, name) -> tuple[str | None, float]:
        for child in sppr:
            tag = localname(child)
            if tag == "noFill":
                return None, 1.0
            if tag == "solidFill":
                return self.theme.color(child)
            if tag == "gradFill":
                warn(f"{name!r}: gradient fill drawn in its first color")
                return self.theme.color(child.find("a:gsLst/a:gs", NS))
            if tag in ("pattFill", "blipFill", "grpFill"):
                warn(f"{name!r}: {tag} not supported, no fill")
                return None, 1.0
        ref = style.find("a:fillRef", NS) if style is not None else None
        if ref is not None and int(ref.get("idx", 0)) > 0:
            return self.theme.color(ref)
        return None, 1.0

    def outline(self, shp: Shape, sppr, style) -> None:
        ln = sppr.find("a:ln", NS) if sppr is not None else None
        ref = style.find("a:lnRef", NS) if style is not None else None
        ref_idx = int(ref.get("idx", 0)) if ref is not None else 0
        own = None
        for child in (ln if ln is not None else []):
            tag = localname(child)
            if tag == "noFill":
                own = (None, 1.0)
            elif tag == "solidFill":
                own = self.theme.color(child)
            elif tag == "gradFill":
                own = self.theme.color(child.find("a:gsLst/a:gs", NS))
            if own is not None:
                break
        if own is not None:
            shp.stroke = own[0]
        elif ref_idx:
            shp.stroke = self.theme.color(ref)[0]
        if not shp.stroke:
            return
        if ln is not None and ln.get("w") is not None:
            shp.stroke_width = pt(ln.get("w"))
        elif ref_idx and self.theme.line_widths:
            shp.stroke_width = self.theme.line_widths[min(ref_idx, len(self.theme.line_widths)) - 1]
        else:
            shp.stroke_width = 1.0
        if ln is None:
            return
        dash = ln.find("a:prstDash", NS)
        shp.dashed = dash is not None and dash.get("val") != "solid"
        for end, attr in (("headEnd", "arrow_start"), ("tailEnd", "arrow_end")):
            e = ln.find(f"a:{end}", NS)
            setattr(shp, attr, e is not None and e.get("type", "none") != "none")

    def image(self, pic, name) -> str | None:
        blip = pic.find("p:blipFill/a:blip", NS)
        rel = self.rels.get(blip.get(R_EMBED)) if blip is not None else None
        if rel is None or rel[2]:
            warn(f"{name!r}: picture not embedded, skipped")
            return None
        ext = rel[1].rsplit(".", 1)[-1].lower()
        if ext not in IMAGE_TYPES:
            warn(f"{name!r}: picture format {ext} not supported, skipped")
            return None
        src = pic.find("p:blipFill/a:srcRect", NS)
        if src is not None and any(src.get(k, "0") != "0" for k in ("l", "t", "r", "b")):
            warn(f"{name!r}: cropping of pictures is ignored")
        data = base64.b64encode(self.pkg.zip.read(rel[1])).decode()
        return f"data:{IMAGE_TYPES[ext]};base64,{data}"

    def text(self, shp: Shape, body, style) -> None:
        bp = body.find("a:bodyPr", NS)
        bp = bp if bp is not None else etree.Element("bodyPr")
        shp.insets = tuple(pt(bp.get(k, d)) for k, d in
                           (("lIns", 91440), ("tIns", 45720), ("rIns", 91440), ("bIns", 45720)))
        shp.anchor = bp.get("anchor", "t")
        shp.wrap = bp.get("wrap", "square") != "none"
        if bp.get("vert", "horz") != "horz":
            warn(f"{shp.name!r}: vertical text is drawn horizontally")
        fit = bp.find("a:normAutofit", NS)
        scale = int(fit.get("fontScale", 100000)) / 1e5 if fit is not None else 1.0
        font_ref = style.find("a:fontRef", NS) if style is not None else None
        default_color = self.theme.color(font_ref)[0] if font_ref is not None else None
        if default_color is None:
            default_color, _ = modified(self.theme.colors.get(self.theme.clrmap.get("tx1", "dk1"), "000000"), [])
        default_font = self.default_font
        if font_ref is not None and font_ref.get("idx") in ("major", "minor"):
            default_font = self.theme.fonts.get(font_ref.get("idx"), default_font)
        for p in body.findall("a:p", NS):
            ppr = p.find("a:pPr", NS)
            para = Para([], ppr.get("algn", "l") if ppr is not None else "l")
            for what, attr in (("spcBef", "space_before"), ("spcAft", "space_after")):
                spc = p.find(f"a:pPr/a:{what}/a:spcPts", NS)
                if spc is not None:
                    setattr(para, attr, int(spc.get("val")) / 100)
            lnspc = p.find("a:pPr/a:lnSpc/a:spcPct", NS)
            if lnspc is not None:
                para.line_scale = int(lnspc.get("val")) / 1e5
            for r in p:
                tag = localname(r)
                if tag not in ("r", "fld", "br"):
                    continue
                rpr = r.find("a:rPr", NS)
                rpr = rpr if rpr is not None else etree.Element("rPr")
                col = self.theme.color(rpr.find("a:solidFill", NS))[0]
                latin = rpr.find("a:latin", NS)
                family = self.resolve_font(latin.get("typeface") if latin is not None else None)
                run = Run("\n" if tag == "br" else r.findtext("a:t", "", NS),
                          int(rpr.get("sz", self.default_size * 100)) / 100 * scale,
                          rpr.get("b") == "1", rpr.get("i") == "1", col or default_color,
                          family or default_font, self.href(rpr))
                para.runs.append(run)
            if para.runs:
                shp.paras.append(para)


# --------------------------------------------------------------- links
def assign_links(shp: Shape, spec) -> str | None:
    """Split the runs into words and spaces and give each its href; return the shape's href."""
    if spec is None:
        default, phrases = None, {}
    elif isinstance(spec, str):
        default, phrases = spec, {}
    else:
        default = spec.get("_")
        phrases = {k: v for k, v in spec.items() if k != "_"}
    default = default or shp.href
    used = set()
    for para in shp.paras:
        words = []
        for r in para.runs:
            for tok in ([r.text] if r.text == "\n" else re.split(r"( +)", r.text)):
                if tok:
                    words.append(Run(tok, r.size, r.bold, r.italic, r.color, r.family, r.href or default))
        for phrase, href in phrases.items():
            parts = phrase.split()
            nonspace = [i for i, w in enumerate(words) if not w.text.isspace()]
            for k in range(len(nonspace) - len(parts) + 1):
                idx = nonspace[k:k + len(parts)]
                if [words[i].text.strip(".,;:()") for i in idx] == parts:
                    for i in range(idx[0], idx[-1] + 1):
                        words[i].href = href
                    used.add(phrase)
        para.runs = words
    missing = set(phrases) - used
    if missing:
        raise SystemExit(f"{shp.name!r}: link phrases not found in its text: {sorted(missing)}")
    return default


# --------------------------------------------------------------- text
def layout(para: Para, width: float, wrap: bool) -> list:
    """Break the runs (words, spaces, and line breaks) of a paragraph into lines."""
    lines, cur, cur_w = [], [], 0.0

    def end_line():
        while cur and cur[-1].text.isspace():
            cur.pop()
        lines.append(list(cur))

    for r in para.runs:
        if r.text == "\n":
            end_line()
            cur, cur_w = [], 0.0
            continue
        w = text_width(r.text, r.size, r.family, r.bold, r.italic)
        if r.text.isspace():
            if cur:
                cur.append(r)
                cur_w += w
            continue
        if wrap and cur and cur_w + w > width + 0.01:
            end_line()
            cur, cur_w = [], 0.0
        cur.append(r)
        cur_w += w
    while cur and cur[-1].text.isspace():
        cur.pop()
    if cur:
        lines.append(cur)
    return lines


def text_svg(shp: Shape, base_family: str, link_target: str) -> str:
    left, top, right, bottom = shp.insets
    box_w = shp.w - left - right
    blocks = []  # (para, lines, size, spacing, ascent)
    total = 0.0
    for i, para in enumerate(shp.paras):
        lines = layout(para, box_w, shp.wrap)
        big = max(para.runs, key=lambda x: x.size, default=None)
        size = big.size if big else 10
        spacing, ascent = metrics(big.family) if big else ARIAL_METRICS
        spacing *= para.line_scale
        blocks.append((para, lines, size, spacing, ascent))
        total += (para.space_before if i else 0) + len(lines) * size * spacing + para.space_after
    if blocks:
        total -= blocks[-1][0].space_after
    if shp.anchor == "ctr":
        y = shp.y + top + (shp.h - top - bottom - total) / 2
    elif shp.anchor == "b":
        y = shp.y + shp.h - bottom - total
    else:
        y = shp.y + top
    target = f" target={quoteattr(link_target)}" if link_target else ""
    out = []
    for i, (para, lines, size, spacing, ascent) in enumerate(blocks):
        if i:
            y += para.space_before
        for line in lines:
            base = y + size * (spacing - 1) / 2 + size * ascent
            if para.align == "ctr":
                x, anchor = shp.x + left + box_w / 2, "middle"
            elif para.align == "r":
                x, anchor = shp.x + shp.w - right, "end"
            else:
                x, anchor = shp.x + left, "start"
            # merge neighbouring words of one style and link
            groups = []
            for w in line:
                key = (w.size, w.bold, w.italic, w.color, w.family, w.href)
                if groups and groups[-1][0] == key:
                    groups[-1][1].append(w)
                else:
                    groups.append((key, [w]))
            spans = []
            for _, g in groups:
                r0 = g[0]
                attrs = f' font-size="{fmt(r0.size)}" fill="{r0.color}"'
                if r0.family != base_family:
                    attrs += f" font-family={quoteattr(font_family(r0.family))}"
                if r0.bold:
                    attrs += ' font-weight="bold"'
                if r0.italic:
                    attrs += ' font-style="italic"'
                span = f"<tspan{attrs}>{escape(''.join(w.text for w in g))}</tspan>"
                if r0.href:
                    span = f"<a href={quoteattr(r0.href)}{target}>{span}</a>"
                spans.append(span)
            if spans:
                out.append(f'<text x="{fmt(x)}" y="{fmt(base)}" text-anchor="{anchor}" '
                           f'xml:space="preserve">{"".join(spans)}</text>')
            y += size * spacing
        y += para.space_after
    return "".join(out)


# --------------------------------------------------------------- shapes
def marker_id(color: str) -> str:
    return "arrow-" + color.lstrip("#").lower()


def line_points(shp: Shape) -> list:
    """Points of a line or connector, from its start to its end."""
    if shp.geom == "bentConnector2":
        local = [(0, 0), (1, 0), (1, 1)]
    elif shp.geom == "bentConnector3":
        a = 0.5 if shp.adj is None else shp.adj
        local = [(0, 0), (a, 0), (a, 1), (1, 1)]
    else:
        local = [(0, 0), (1, 1)]
    return [(shp.x + shp.w * ((1 - u) if shp.flip_h else u),
             shp.y + shp.h * ((1 - v) if shp.flip_v else v)) for u, v in local]


def stroke_attrs(shp: Shape) -> str:
    if not shp.stroke:
        return ' stroke="none"'
    s = f' stroke="{shp.stroke}" stroke-width="{fmt(shp.stroke_width)}"'
    if shp.dashed:
        s += f' stroke-dasharray="{fmt(DASH[0] * shp.stroke_width)},{fmt(DASH[1] * shp.stroke_width)}"'
    return s


def shorten(p, q, by):
    """Move q towards p by `by` (the arrow head, whose tip is at q)."""
    d = math.hypot(q[0] - p[0], q[1] - p[1])
    k = by / d if d else 0
    return q[0] - (q[0] - p[0]) * k, q[1] - (q[1] - p[1]) * k


def segment_svg(shp: Shape, pts, arrow_start: bool, arrow_end: bool) -> str:
    pts = list(pts)
    extra = ""
    if shp.stroke and arrow_start:
        pts[0] = shorten(pts[1], pts[0], 2.5 * shp.stroke_width)
        extra += f' marker-start="url(#{marker_id(shp.stroke)})"'
    if shp.stroke and arrow_end:
        pts[-1] = shorten(pts[-2], pts[-1], 2.5 * shp.stroke_width)
        extra += f' marker-end="url(#{marker_id(shp.stroke)})"'
    if len(pts) == 2:
        (x1, y1), (x2, y2) = pts
        return (f'<line x1="{fmt(x1)}" y1="{fmt(y1)}" x2="{fmt(x2)}" y2="{fmt(y2)}"'
                f'{stroke_attrs(shp)} fill="none"{extra}/>')
    points = " ".join(f"{fmt(x)},{fmt(y)}" for x, y in pts)
    return f'<polyline points="{points}"{stroke_attrs(shp)} fill="none"{extra}/>'


def shape_svg(shp: Shape, href: str | None, base_family: str, link_target: str) -> str:
    target = f" target={quoteattr(link_target)}" if link_target else ""
    if shp.kind == "line":
        el = segment_svg(shp, line_points(shp), shp.arrow_start, shp.arrow_end)
        if href and shp.stroke:
            el = f"<a href={quoteattr(href)}{target}>{el}</a>"
        return el + text_svg(shp, base_family, link_target)
    if shp.kind == "picture":
        el = (f'<image x="{fmt(shp.x)}" y="{fmt(shp.y)}" width="{fmt(shp.w)}" height="{fmt(shp.h)}" '
              f'preserveAspectRatio="none" xlink:href="{shp.image}"/>')
        if shp.flip_h or shp.flip_v:
            cx, cy = shp.x + shp.w / 2, shp.y + shp.h / 2
            el = (f'<g transform="translate({fmt(cx)} {fmt(cy)}) scale({-1 if shp.flip_h else 1} '
                  f'{-1 if shp.flip_v else 1}) translate({fmt(-cx)} {fmt(-cy)})">{el}</g>')
        if shp.stroke:
            el += (f'<rect x="{fmt(shp.x)}" y="{fmt(shp.y)}" width="{fmt(shp.w)}" '
                   f'height="{fmt(shp.h)}" fill="none"{stroke_attrs(shp)}/>')
        if href:
            el = f"<a href={quoteattr(href)}{target}>{el}</a>"
        return el
    fill = f' fill="{shp.fill}"' if shp.fill else ' fill="none"'
    if shp.fill and shp.fill_opacity < 1:
        fill += f' fill-opacity="{fmt(shp.fill_opacity)}"'
    common = fill + stroke_attrs(shp)
    if shp.geom == "ellipse":
        el = (f'<ellipse cx="{fmt(shp.x + shp.w / 2)}" cy="{fmt(shp.y + shp.h / 2)}" '
              f'rx="{fmt(shp.w / 2)}" ry="{fmt(shp.h / 2)}"{common}/>')
    else:
        rx = ""
        if shp.geom == "roundRect":
            rad = min(shp.w, shp.h) * (0.16667 if shp.adj is None else shp.adj)
            rx = f' rx="{fmt(rad)}"'
        el = (f'<rect x="{fmt(shp.x)}" y="{fmt(shp.y)}" width="{fmt(shp.w)}" '
              f'height="{fmt(shp.h)}"{rx}{common}/>')
    if href and (shp.fill or shp.stroke):
        el = f"<a href={quoteattr(href)}{target}>{el}</a>"
    return el + text_svg(shp, base_family, link_target)


def transform_attr(shp: Shape) -> str:
    ts = list(shp.transforms)
    if shp.rot:
        ts.append(f"rotate({fmt(shp.rot)} {fmt(shp.x + shp.w / 2)} {fmt(shp.y + shp.h / 2)})")
    return f' transform="{" ".join(ts)}"' if ts else ""


# --------------------------------------------------------------- conversion
def convert(src: Path, out: Path, slide: int = 1, cfg: dict | None = None,
            cfg_name: str | None = None, font_default: str = "Arial",
            link_target: str = "_blank", write_svgtune: bool = True) -> dict:
    """Write the SVG (and .svgtune) of a slide; return counts of what was written."""
    _warned.clear()
    src, out = Path(src), Path(out)
    cfg = cfg or {}
    links = dict(cfg.get("links") or {})
    steps = [(name, re.compile(rx)) for name, rx in cfg.get("steps") or []]
    splits = dict(cfg.get("split") or {})

    pkg = Package(src)
    slides = pkg.slides()
    if not 1 <= slide <= len(slides):
        raise SystemExit(f"{src}: no slide {slide} (it has {len(slides)})")
    sld = Slide(pkg, slides[slide - 1], font_default)
    shapes = list(sld.shapes())

    # the font of most runs is the default of the whole SVG
    counts = {}
    for shp, _ in shapes:
        for para in shp.paras:
            for r in para.runs:
                counts[r.family] = counts.get(r.family, 0) + len(r.text)
    base_family = max(counts, key=counts.get) if counts else sld.default_font

    items = []  # (step, svg)
    seen_ids = {}
    unused_links = set(links)
    colors = set()
    for shp, groups in shapes:
        sid = slug(shp.name)
        seen_ids[sid] = seen_ids.get(sid, 0) + 1
        if seen_ids[sid] > 1:
            sid += f"-{seen_ids[sid]}"
        step = next((n for n, rx in steps if rx.search(shp.name)), None)
        for g in reversed(groups):
            if step is None:
                step = next((n for n, rx in steps if rx.search(g)), None)
        step = step or "base"
        unused_links.discard(shp.name)
        href = assign_links(shp, links.get(shp.name))
        label = quoteattr(shp.name)
        if shp.stroke and (shp.arrow_start or shp.arrow_end):
            colors.add(shp.stroke)
        tf = transform_attr(shp)
        if shp.name in splits and shp.kind == "line" and len(line_points(shp)) == 2:
            sp = splits.pop(shp.name)
            (x1, y1), (x2, y2) = line_points(shp)
            # cut points along the line, in order from its start to its end
            cuts = sorted(sp["at"], key=lambda c: abs(c - (y1 if x1 == x2 else x1)))
            pts = [(x1, y1)] + [((x1, c) if x1 == x2 else (c, y1)) for c in cuts] + [(x2, y2)]
            if len(sp["steps"]) != len(pts) - 1:
                raise SystemExit(f"split of {shp.name!r}: {len(pts) - 1} segments but "
                                 f"{len(sp['steps'])} steps")
            for i, st in enumerate(sp["steps"]):
                body = segment_svg(shp, pts[i:i + 2], shp.arrow_start and i == 0,
                                   shp.arrow_end and i == len(pts) - 2)
                items.append((st, f'<g id="{sid}-{i + 1}" inkscape:label={label}{tf}>{body}</g>'))
            continue
        items.append((step, f'<g id="{sid}" inkscape:label={label}{tf}>'
                            f'{shape_svg(shp, href, base_family, link_target)}</g>'))
    if unused_links:
        raise SystemExit(f"links for shapes not in the slide: {sorted(unused_links)}")
    if splits:
        raise SystemExit(f"split for lines not in the slide: {sorted(splits)}")

    defs = "".join(
        f'<marker id="{marker_id(c)}" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="3" '
        f'markerHeight="3" orient="auto-start-reverse" markerUnits="strokeWidth">'
        f'<path d="M0,0 L10,5 L0,10 z" fill="{c}"/></marker>' for c in sorted(colors))
    layers, layer_counts = [], {}
    for step, svg in items:
        if layers and layers[-1][0] == step:
            layers[-1][1].append(svg)
        else:
            layers.append((step, [svg]))
    body = []
    for step, svgs in layers:
        layer_counts[step] = layer_counts.get(step, 0) + 1
        lid = f"layer-{slug(step)}" + (f"-{layer_counts[step]}" if layer_counts[step] > 1 else "")
        body.append(f'<g inkscape:groupmode="layer" id="{lid}" inkscape:label="{escape(step)}" '
                    f'style="display:inline">\n' + "\n".join(svgs) + "\n</g>")
    title = escape(str(cfg.get("title", src.stem)))
    sources = src.name + (f" and {cfg_name}" if cfg_name else "")
    xlink = ' xmlns:xlink="http://www.w3.org/1999/xlink"' if any(s.image for s, _ in shapes) else ""
    W, H = sld.width, sld.height
    svg = (
        '<?xml version="1.0" encoding="UTF-8"?>\n'
        f"<!-- Generated by pptx2svgtune from {escape(sources)}: edit those, not this file. -->\n"
        f'<svg xmlns="http://www.w3.org/2000/svg" '
        f'xmlns:inkscape="http://www.inkscape.org/namespaces/inkscape"{xlink} '
        f'width="{fmt(W)}pt" height="{fmt(H)}pt" viewBox="0 0 {fmt(W)} {fmt(H)}" '
        f"font-family={quoteattr(font_family(base_family))}>\n"
        f"<title>{title}</title>\n<defs>{defs}</defs>\n"
        f'<rect id="background" width="{fmt(W)}" height="{fmt(H)}" fill="{sld.theme.background}"/>\n'
        + "\n".join(body) + "\n</svg>\n")
    out.write_text(svg)
    n_links = svg.count("<a ")
    print(f"wrote {out} ({len(items)} shapes, {len(layers)} layers, {n_links} links)")

    if write_svgtune:
        order = list(cfg.get("walkthrough") or [])
        order += [s for s, _ in steps] + [st for sp in (cfg.get("split") or {}).values()
                                          for st in sp["steps"]]
        write_tune(out, src, order, [step for step, _ in layers])
    return {"shapes": len(items), "layers": len(layers), "links": n_links}


GENERATED = "# Generated by pptx2svgtune"


def write_tune(out: Path, src: Path, order: list, present: list) -> None:
    """Write <out>.svgtune: base, then each step present, in configuration order."""
    tune = out.with_suffix(".svgtune")
    if tune.exists() and not tune.read_text().startswith(GENERATED):
        print(f"kept {tune} (edited: its first line is not the {GENERATED!r} comment)")
        return
    seq = []
    for step in ["base"] + order + present:
        if step in present and step not in seq:
            seq.append(step)
    lines = [f"{GENERATED} from {src.name}: remove this line to keep your edits.",
             f"# Run: svgtune {tune.name}   -> {out.stem}_tuned/<step>.svg",
             f"%file {out.name}",
             "layers style=display:none"]
    for step in seq:
        lines += [f"layer label:re=^{re.escape(step)}$ style=display:inline", f"%save {step}"]
    tune.write_text("\n".join(lines) + "\n")
    print(f"wrote {tune} ({len(seq)} steps)")


def main(argv=None) -> None:
    ap = argparse.ArgumentParser(
        prog="pptx2svgtune",
        description=__doc__.split("\n\n")[0],
        epilog="See the module docstring (or README) for the configuration and what is supported.")
    ap.add_argument("source", nargs="?", help=".pptx file (default: 'source' of the configuration)")
    ap.add_argument("-c", "--config", metavar="YAML",
                    help="configuration: links, build steps, and more")
    ap.add_argument("-o", "--output", metavar="SVG",
                    help="SVG file to write (default: 'output' of the configuration, "
                         "else <source>.svg)")
    ap.add_argument("--slide", type=int, metavar="N",
                    help="slide to convert, counting from 1 (default: 1)")
    ap.add_argument("--font", default="Arial",
                    help="font for text when the presentation names none (default: %(default)s)")
    ap.add_argument("--link-target", default="_blank", metavar="TARGET",
                    help="target of links (default: %(default)s; '' for none)")
    ap.add_argument("--no-svgtune", action="store_true", help="do not write the .svgtune file")
    args = ap.parse_args(argv)
    if args.source is None and args.config is None:
        ap.error("give a .pptx file, a configuration with 'source', or both")
    cfg, here, cfg_name = {}, Path("."), None
    if args.config:
        try:
            import yaml
        except ImportError:
            raise SystemExit("PyYAML is needed to read a configuration file")
        cfg_file = Path(args.config)
        cfg = yaml.safe_load(cfg_file.read_text()) or {}
        here, cfg_name = cfg_file.parent, cfg_file.name
    if args.source:
        src = Path(args.source)
    elif cfg.get("source"):
        src = here / cfg["source"]
    else:
        ap.error(f"{args.config} has no 'source'")
    slide = args.slide or int(cfg.get("slide", 1))
    if args.output:
        out = Path(args.output)
    elif cfg.get("output"):
        out = here / cfg["output"]
    else:
        out = src.with_name(src.stem + (".svg" if slide == 1 else f"-slide{slide}.svg"))
    convert(src, out, slide, cfg, cfg_name, args.font, args.link_target, not args.no_svgtune)


if __name__ == "__main__":
    main()
