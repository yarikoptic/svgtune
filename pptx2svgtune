NS = {
    "a": "http://schemas.openxmlformats.org/drawingml/2006/main",
    "p": "http://schemas.openxmlformats.org/presentationml/2006/main",
    "r": "http://schemas.openxmlformats.org/officeDocument/2006/relationships",
}
R_ID = "{%s}id" % NS["r"]
R_EMBED = "{%s}embed" % NS["r"]
EMU_PT = 12700.0
DASH = (4, 3)  # PowerPoint "dash": dash and gap in line widths
# PowerPoint's single line spacing and the ascent, in font sizes, for Arial
# and metric-compatible fonts; other fonts use their own ascent and 1.2
ARIAL_METRICS = (1.17, 0.905)
ARIAL_LIKE = ("arial", "liberation sans", "arimo", "helvetica")
# Metric-compatible fonts, as fallbacks in font-family
FALLBACKS = {
    "Arial": ["Liberation Sans", "Helvetica", "sans-serif"],
    "Calibri": ["Carlito", "sans-serif"],
    "Calibri Light": ["Carlito", "sans-serif"],
    "Cambria": ["Caladea", "serif"],
    "Times New Roman": ["Liberation Serif", "serif"],
    "Courier New": ["Liberation Mono", "monospace"],
}
COLOR_TAGS = ("srgbClr", "schemeClr", "sysClr", "prstClr", "scrgbClr", "hslClr")
PRESET_COLORS = {"black": "000000", "white": "FFFFFF", "red": "FF0000", "green": "008000",
                 "blue": "0000FF", "yellow": "FFFF00", "gray": "808080", "grey": "808080"}
CLRMAP_DEFAULT = {"bg1": "lt1", "tx1": "dk1", "bg2": "lt2", "tx2": "dk2"}
SHAPE_GEOMS = ("rect", "roundRect", "ellipse")
LINE_GEOMS = ("line", "straightConnector1", "bentConnector2", "bentConnector3")
IMAGE_TYPES = {"png": "image/png", "jpg": "image/jpeg", "jpeg": "image/jpeg",
               "gif": "image/gif", "svg": "image/svg+xml", "bmp": "image/bmp",
               "webp": "image/webp"}

_warned = set()


def warn(msg):
    if msg not in _warned:
        _warned.add(msg)
        print("WARNING:", msg, file=sys.stderr)


def pt(v) -> float:
    return int(v) / EMU_PT


def fmt(v: float) -> str:
    return f"{v:.2f}".rstrip("0").rstrip(".")


def localname(el) -> str:
    return etree.QName(el).localname


def slug(name: str) -> str:
    s = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")
    return s if s and s[0].isalpha() else "s-" + s


# --------------------------------------------------------------- fonts
@lru_cache(None)
def font(family: str, bold: bool, italic: bool):
    from PIL import ImageFont
    style = ":bold" * bold + ":italic" * italic
    try:
        path = subprocess.run(["fc-match", "-f", "%{file}", family + style],
                              capture_output=True, text=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError) as exc:
        raise SystemExit(f"cannot find a font for {family!r} with fc-match: {exc}")
    return ImageFont.truetype(path, 100)


def text_width(s: str, size: float, family: str, bold: bool, italic: bool) -> float:
    return font(family, bold, italic).getlength(s) * size / 100.0


@lru_cache(None)
def metrics(family: str) -> tuple[float, float]:
    """Line spacing and ascent of a font, in font sizes."""
    f = font(family, False, False)
    if family.lower() in ARIAL_LIKE or any(n.lower() in ARIAL_LIKE for n in f.getname()[:1]):
        return ARIAL_METRICS
    return 1.2, f.getmetrics()[0] / 100.0


def font_family(family: str) -> str:
    names = [family] + FALLBACKS.get(family, ["sans-serif"])
    generic = ("serif", "sans-serif", "monospace")
    return ", ".join(n if n in generic or " " not in n else f"'{n}'" for n in names)


# --------------------------------------------------------------- package
class Package:
    """The parts of a .pptx: a zip of XML parts, linked by relationships."""

    def __init__(self, path):
        self.zip = zipfile.ZipFile(path)
        self.names = set(self.zip.namelist())

    def xml(self, part):
        return etree.fromstring(self.zip.read(part))

    def rels(self, part) -> dict:
        """{rId: (type, part name or URL, external)} of a part."""
        folder, base = posixpath.split(part)
        rels_part = posixpath.join(folder, "_rels", base + ".rels")
        if rels_part not in self.names:
            return {}
        out = {}
        for rel in self.xml(rels_part):
            target, external = rel.get("Target"), rel.get("TargetMode") == "External"
            if not external:
                target = (target.lstrip("/") if target.startswith("/")
                          else posixpath.normpath(posixpath.join(folder, target)))
            out[rel.get("Id")] = (rel.get("Type").rsplit("/", 1)[-1], target, external)
        return out

    def related(self, part, rtype):
        return next((t for ty, t, ext in self.rels(part).values() if ty == rtype and not ext), None)

    def slides(self) -> list:
        pres = "ppt/presentation.xml"
        rels = self.rels(pres)
        return [rels[s.get(R_ID)][1] for s in self.xml(pres).findall("p:sldIdLst/p:sldId", NS)]


class Theme:
    """Colors, fonts, line widths, and background of a slide, from its layout, master, and theme."""

    def __init__(self, pkg: Package, slide: str):
        layout = pkg.related(slide, "slideLayout")
        master = layout and pkg.related(layout, "slideMaster")
        theme = master and pkg.related(master, "theme")
        self.colors, self.fonts, self.line_widths = {}, {}, []
        self.clrmap = dict(CLRMAP_DEFAULT)
        if master:
            cm = pkg.xml(master).find("p:clrMap", NS)
            if cm is not None:
                self.clrmap.update(cm.attrib)
        if theme:
            t = pkg.xml(theme)
            scheme = t.find("a:themeElements/a:clrScheme", NS)
            for c in (scheme if scheme is not None else []):
                v = c.find("a:srgbClr", NS)
                if v is not None:
                    self.colors[localname(c)] = v.get("val")
                elif c.find("a:sysClr", NS) is not None:
                    self.colors[localname(c)] = c.find("a:sysClr", NS).get("lastClr", "000000")
            for kind in ("major", "minor"):
                latin = t.find(f"a:themeElements/a:fontScheme/a:{kind}Font/a:latin", NS)
                if latin is not None and latin.get("typeface"):
                    self.fonts[kind] = latin.get("typeface")
            self.line_widths = [pt(ln.get("w", 9525)) for ln in
                                t.findall("a:themeElements/a:fmtScheme/a:lnStyleLst/a:ln", NS)]
        self.background = "#ffffff"
        for part in (slide, layout, master):
            if not part:
                continue
            bg = pkg.xml(part).find("p:cSld/p:bg", NS)
            if bg is None:
                continue
            fill = bg.find("p:bgPr/a:solidFill", NS)
            if fill is None:
                fill = bg.find("p:bgRef", NS)
            color = self.color(fill)[0] if fill is not None else None
            if color is None:
                warn("background other than a solid color: white used")
            self.background = (color or "#ffffff").lower()
            break

    def color(self, container) -> tuple[str | None, float]:
        """(#rrggbb, alpha) of the color within a solidFill, gs, fillRef, lnRef, ..."""
        if container is None:
            return None, 1.0
        c = next((ch for ch in container if localname(ch) in COLOR_TAGS), None)
        if c is None:
            return None, 1.0
        tag = localname(c)
        if tag == "srgbClr":
            rgb = c.get("val")
        elif tag == "sysClr":
            rgb = c.get("lastClr", "000000")
        elif tag == "schemeClr":
            name = self.clrmap.get(c.get("val"), c.get("val"))
            rgb = self.colors.get(name)
            if rgb is None:
                warn(f"theme color {c.get('val')} not found: black used")
                rgb = "000000"
        elif tag == "prstClr" and c.get("val") in PRESET_COLORS:
            rgb = PRESET_COLORS[c.get("val")]
        else:
            warn(f"color <{tag}> not supported: black used")
            rgb = "000000"
        return modified(rgb, c)


def to_linear(c: float) -> float:
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def from_linear(c: float) -> float:
    return c * 12.92 if c <= 0.0031308 else 1.055 * c ** (1 / 2.4) - 0.055


def modified(rgb: str, color) -> tuple[str, float]:
    """Apply the modifiers of a color element (lumMod, lumOff, shade, tint, alpha)."""
    r, g, b = (int(rgb[i:i + 2], 16) / 255 for i in (0, 2, 4))
    alpha, changed = 1.0, False
    for m in color:
        name, val = localname(m), m.get("val")
        if val is None:
            warn(f"color modifier {name} ignored")
            continue
        v = int(val) / 1e5
        if name == "alpha":
            alpha = v
            continue
        if name in ("lumMod", "lumOff"):
            h, light, s = colorsys.rgb_to_hls(r, g, b)
            light = light * v if name == "lumMod" else light + v
            r, g, b = colorsys.hls_to_rgb(h, min(max(light, 0.0), 1.0), s)
        elif name == "shade":  # towards black, in linear RGB
            r, g, b = (from_linear(to_linear(x) * v) for x in (r, g, b))
        elif name == "tint":  # towards white, in linear RGB
            r, g, b = (from_linear(1 - (1 - to_linear(x)) * v) for x in (r, g, b))
        else:
            warn(f"color modifier {name} ignored")
            continue
        changed = True
    if changed:
        rgb = "".join(f"{round(min(max(x, 0.0), 1.0) * 255):02X}" for x in (r, g, b))
    return "#" + rgb, alpha


